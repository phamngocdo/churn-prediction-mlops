FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.4.29 /uv /usr/local/bin/uv

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY src ./src

RUN uv pip install --system --no-cache ".[api]"

ENV MLFLOW_TRACKING_URI=http://mlflow:5000 \
    MODEL_REGISTRY_NAME=churn_model \
    API_HOST=0.0.0.0 \
    API_PORT=8000

EXPOSE 8000

CMD ["uvicorn", "churn_mlops.serving.api:app", "--host", "0.0.0.0", "--port", "8000"]

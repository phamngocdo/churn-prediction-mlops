FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.4.29 /uv /usr/local/bin/uv

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src

RUN uv pip install --system --no-cache ".[web]"

ENV API_URL=http://api:8000

EXPOSE 8501

CMD ["streamlit", "run", "src/churn_mlops/serving/streamlit_app.py", \
     "--server.address=0.0.0.0", "--server.port=8501"]
